{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "notes": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string"
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "nights": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "startingGold": {
      "type": "number",
      "minimum": 0
    },
    "castle": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "hp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "default": 1,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "income": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "attack": {
          "type": "object",
          "properties": {
            "damage": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "interval": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "range": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "aoe": {
              "default": 0,
              "type": "number",
              "minimum": 0
            },
            "maxTargets": {
              "default": 1,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "arc": {
              "default": 360,
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 360
            },
            "bonus": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "targets": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ground",
                  "air"
                ]
              }
            },
            "projectile": {
              "type": "object",
              "properties": {
                "speed": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "speed"
              ]
            }
          },
          "required": [
            "damage",
            "interval",
            "range",
            "targets"
          ]
        }
      },
      "required": [
        "node",
        "hp"
      ]
    },
    "kingSpawn": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "pos": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "slot": {
            "type": "object",
            "properties": {
              "options": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                }
              },
              "rally": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                }
              }
            },
            "required": [
              "options"
            ]
          }
        },
        "required": [
          "id",
          "pos"
        ]
      }
    },
    "lanes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "air": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "path"
        ]
      }
    },
    "waves": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "night": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "groups": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lane": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "enemy": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "count": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "delay": {
                  "default": 0,
                  "type": "number",
                  "minimum": 0
                },
                "interval": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "lane",
                "enemy",
                "count"
              ]
            }
          }
        },
        "required": [
          "night",
          "groups"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "size",
    "nights",
    "startingGold",
    "castle",
    "kingSpawn",
    "nodes",
    "lanes",
    "waves"
  ]
}
