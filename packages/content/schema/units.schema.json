{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "notes": {
      "type": "string"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "hp": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radius": {
            "default": 0.3,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "armor": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 0.9
          },
          "guardRadius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "leash": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "attack": {
            "type": "object",
            "properties": {
              "damage": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "interval": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "range": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "aoe": {
                "default": 0,
                "type": "number",
                "minimum": 0
              },
              "maxTargets": {
                "default": 1,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "arc": {
                "default": 360,
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 360
              },
              "bonus": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "targets": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "ground",
                    "air"
                  ]
                }
              },
              "projectile": {
                "type": "object",
                "properties": {
                  "speed": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "speed"
                ]
              }
            },
            "required": [
              "damage",
              "interval",
              "range",
              "targets"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "hp",
          "speed",
          "guardRadius",
          "leash",
          "attack"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "units"
  ]
}
