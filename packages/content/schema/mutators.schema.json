{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "notes": {
      "type": "string"
    },
    "mutators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "scoreBonus": {
            "type": "number",
            "minimum": -0.9,
            "maximum": 5
          },
          "modifiers": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stat": {
                  "type": "string",
                  "pattern": "^((building|unit|enemy)\\.(\\*|class:[a-z]+|[a-z0-9][a-z0-9_-]*)|king|weapon|castle|rules)(\\.[a-zA-Z]+)+$"
                },
                "op": {
                  "type": "string",
                  "enum": ["add", "mul"]
                },
                "value": {
                  "type": "number"
                },
                "nights": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "required": ["stat", "op", "value"]
            }
          },
          "closesClasses": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["eco", "tower", "wall", "military"]
            }
          },
          "unlock": {
            "type": "object",
            "properties": {
              "level": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["level"]
          }
        },
        "required": ["id", "name", "description", "scoreBonus"]
      }
    }
  },
  "required": ["schemaVersion", "mutators"]
}
