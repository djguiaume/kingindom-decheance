{
  "$schema": "../schema/buildings.schema.json",
  "schemaVersion": 1,
  "notes": "Prototype design 11 §4. castleLevel is the tier: the castle level needed to build or upgrade into it (corpus 13 §1.1). Upgrade-only buildings repeat their upgrade edge's cost. Eco income raised after the first playtest (gold felt scarce).",
  "buildings": [
    {
      "id": "house",
      "name": "House",
      "description": "Pays gold every dawn.",
      "class": "eco",
      "cost": 15,
      "hp": 150,
      "income": 10,
      "radius": 0.9,
      "upgrades": [{ "to": "manor", "cost": 20 }]
    },
    {
      "id": "manor",
      "name": "Manor",
      "description": "A bigger house: pays more gold every dawn.",
      "class": "eco",
      "cost": 20,
      "castleLevel": 2,
      "hp": 250,
      "income": 20,
      "radius": 1
    },
    {
      "id": "gold_mine",
      "name": "Gold mine",
      "description": "Pays the most gold every dawn.",
      "class": "eco",
      "cost": 30,
      "hp": 200,
      "income": 25,
      "radius": 1
    },
    {
      "id": "tower",
      "name": "Tower",
      "description": "Shoots arrows at ground and air enemies.",
      "class": "tower",
      "cost": 25,
      "hp": 300,
      "radius": 0.8,
      "attack": { "damage": 8, "interval": 1, "range": 7, "targets": ["ground", "air"] },
      "upgrades": [{ "to": "watchtower", "cost": 35 }]
    },
    {
      "id": "watchtower",
      "name": "Watchtower",
      "description": "Taller tower: more damage and range.",
      "class": "tower",
      "cost": 35,
      "castleLevel": 2,
      "hp": 400,
      "radius": 0.8,
      "attack": { "damage": 12, "interval": 1, "range": 8.5, "targets": ["ground", "air"] },
      "upgrades": [
        { "to": "ballista_tower", "cost": 50, "exclusiveGroup": "tower_t3" },
        { "to": "volley_tower", "cost": 50, "exclusiveGroup": "tower_t3" }
      ]
    },
    {
      "id": "ballista_tower",
      "name": "Ballista tower",
      "description": "Heavy bolts that wreck brutes and bosses. Can't hit flyers.",
      "class": "tower",
      "cost": 50,
      "castleLevel": 3,
      "hp": 500,
      "radius": 0.9,
      "attack": {
        "damage": 40,
        "interval": 2,
        "range": 10,
        "bonus": { "tank": 1.6 },
        "targets": ["ground"]
      }
    },
    {
      "id": "volley_tower",
      "name": "Volley tower",
      "description": "Shoots three enemies at once.",
      "class": "tower",
      "cost": 50,
      "castleLevel": 3,
      "hp": 450,
      "radius": 0.9,
      "attack": {
        "damage": 8,
        "interval": 1,
        "range": 8,
        "maxTargets": 3,
        "targets": ["ground", "air"]
      }
    },
    {
      "id": "wall",
      "name": "Wall",
      "description": "Blocks the road: enemies must break it to pass.",
      "class": "wall",
      "cost": 10,
      "hp": 500,
      "radius": 1.2,
      "upgrades": [{ "to": "stone_wall", "cost": 20 }]
    },
    {
      "id": "stone_wall",
      "name": "Stone wall",
      "description": "A much tougher wall.",
      "class": "wall",
      "cost": 20,
      "castleLevel": 2,
      "hp": 1200,
      "radius": 1.2
    },
    {
      "id": "barracks",
      "name": "Barracks",
      "description": "Trains footmen who guard its flag at night.",
      "class": "military",
      "cost": 40,
      "hp": 400,
      "radius": 1.2,
      "spawns": { "unit": "footman", "count": 3 },
      "upgrades": [{ "to": "garrison", "cost": 40 }]
    },
    {
      "id": "garrison",
      "name": "Garrison",
      "description": "Trains more footmen.",
      "class": "military",
      "cost": 40,
      "castleLevel": 2,
      "hp": 600,
      "radius": 1.3,
      "spawns": { "unit": "footman", "count": 5 }
    }
  ]
}
