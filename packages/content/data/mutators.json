{
  "$schema": "../schema/mutators.schema.json",
  "schemaVersion": 1,
  "notes": "Mutators, corpus 13 §3. Each strains one part of the game and adds its bonus to a won run's score multiplier; bonuses add up. Starting values: the bots set the real bonuses (a bonus should match the drop in the balanced bot's win rate).",
  "mutators": [
    {
      "id": "swarm",
      "name": "Swarm",
      "description": "Nights 1 and 2 have twice as many enemies.",
      "scoreBonus": 0.3,
      "modifiers": [{ "stat": "rules.waveSize", "op": "mul", "value": 2, "nights": [1, 2] }]
    },
    {
      "id": "ironhide",
      "name": "Ironhide",
      "description": "Enemies have +50% HP.",
      "scoreBonus": 0.4,
      "modifiers": [{ "stat": "enemy.*.hp", "op": "mul", "value": 1.5 }]
    },
    {
      "id": "lean_years",
      "name": "Lean Years",
      "description": "All income −30%, castle and buildings.",
      "scoreBonus": 0.35,
      "modifiers": [{ "stat": "rules.incomeRate", "op": "mul", "value": 0.7 }]
    },
    {
      "id": "swift_foe",
      "name": "Swift Foe",
      "description": "Enemies move 30% faster.",
      "scoreBonus": 0.25,
      "modifiers": [{ "stat": "enemy.*.speed", "op": "mul", "value": 1.3 }]
    },
    {
      "id": "no_walls",
      "name": "No Walls",
      "description": "Walls cannot be built.",
      "scoreBonus": 0.4,
      "closesClasses": ["wall"]
    },
    {
      "id": "glass_crown",
      "name": "Glass Crown",
      "description": "King HP −50% and no regeneration.",
      "scoreBonus": 0.3,
      "modifiers": [
        { "stat": "king.hp", "op": "mul", "value": 0.5 },
        { "stat": "king.regen", "op": "mul", "value": 0 }
      ]
    },
    {
      "id": "mercy",
      "name": "Mercy",
      "description": "Enemies have −25% HP. Easier: lowers the score.",
      "scoreBonus": -0.3,
      "modifiers": [{ "stat": "enemy.*.hp", "op": "mul", "value": 0.75 }]
    }
  ]
}
