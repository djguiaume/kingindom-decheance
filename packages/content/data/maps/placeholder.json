{
  "$schema": "../../schema/map.schema.json",
  "schemaVersion": 1,
  "notes": "PLACEHOLDER map to exercise the core: two ground lanes, one air lane. Not the prototype map.",
  "id": "placeholder",
  "name": "Placeholder field",
  "nights": 3,
  "startingGold": 12,
  "castle": { "node": "castle", "hp": 100, "radius": 1.2 },
  "kingSpawn": "king-start",
  "nodes": [
    { "id": "castle", "pos": [20, 15] },
    { "id": "king-start", "pos": [20, 17] },
    { "id": "spawn-w", "pos": [0, 15] },
    { "id": "w1", "pos": [9, 15] },
    { "id": "spawn-e", "pos": [40, 15] },
    { "id": "e1", "pos": [31, 13] },
    { "id": "spawn-n", "pos": [20, 0] },
    { "id": "slot-house-1", "pos": [18, 19], "slot": { "options": ["house"] } },
    { "id": "slot-house-2", "pos": [22, 11], "slot": { "options": ["house"] } },
    { "id": "slot-farm", "pos": [7, 21], "slot": { "options": ["farm"] } },
    { "id": "slot-tower-w", "pos": [13, 12], "slot": { "options": ["tower"] } },
    { "id": "slot-tower-e", "pos": [27, 17], "slot": { "options": ["tower"] } },
    { "id": "slot-wall-w", "pos": [12, 15], "slot": { "options": ["wall"] } },
    { "id": "slot-barracks", "pos": [16, 17], "slot": { "options": ["barracks"] } }
  ],
  "lanes": [
    { "id": "west", "path": ["spawn-w", "w1", "castle"] },
    { "id": "east", "path": ["spawn-e", "e1", "castle"] },
    { "id": "north-air", "path": ["spawn-n", "castle"], "air": true }
  ],
  "waves": [
    { "night": 1, "groups": [{ "lane": "west", "enemy": "grunt", "count": 4, "interval": 1.5 }] },
    {
      "night": 2,
      "groups": [
        { "lane": "west", "enemy": "grunt", "count": 5, "interval": 1.2 },
        { "lane": "east", "enemy": "grunt", "count": 3, "delay": 3, "interval": 1.5 },
        { "lane": "north-air", "enemy": "bat", "count": 2, "delay": 6, "interval": 2 }
      ]
    },
    {
      "night": 3,
      "groups": [
        { "lane": "west", "enemy": "brute", "count": 2, "interval": 4 },
        { "lane": "east", "enemy": "grunt", "count": 6, "interval": 1 },
        { "lane": "north-air", "enemy": "bat", "count": 4, "delay": 4, "interval": 1.5 }
      ]
    }
  ]
