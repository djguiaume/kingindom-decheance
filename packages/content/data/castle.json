{
  "$schema": "../schema/castle.schema.json",
  "schemaVersion": 1,
  "notes": "Castle upgrades, corpus 13 §1. Level 1 is the map's castle. Levels cost gold only, no night requirement; each unlocks the buildings of its tier and offers a pick of one perk out of three. Starting values, tuned with the bots.",
  "levels": [
    {
      "level": 2,
      "cost": 35,
      "hp": 2000,
      "attack": { "damage": 8, "interval": 1, "range": 9, "targets": ["ground", "air"] },
      "perks": ["tithe", "royal_archers", "commander"]
    },
    {
      "level": 3,
      "cost": 80,
      "hp": 2500,
      "attack": { "damage": 12, "interval": 1, "range": 10, "targets": ["ground", "air"] },
      "perks": ["fortress", "hero_king", "gamblers_oath"]
    }
  ],
  "perks": [
    {
      "id": "tithe",
      "name": "Tithe",
      "description": "Houses and manors pay +5 gold every dawn.",
      "modifiers": [
        { "stat": "building.house.income", "op": "add", "value": 5 },
        { "stat": "building.manor.income", "op": "add", "value": 5 }
      ]
    },
    {
      "id": "royal_archers",
      "name": "Royal Archers",
      "description": "The castle shoots twice as hard and 3 m farther.",
      "modifiers": [
        { "stat": "castle.attack.damage", "op": "mul", "value": 2 },
        { "stat": "castle.attack.range", "op": "add", "value": 3 }
      ]
    },
    {
      "id": "commander",
      "name": "Commander",
      "description": "Rally reaches 12 m instead of 6; soldiers with the king deal +30% damage.",
      "modifiers": [
        { "stat": "rules.rallyReach", "op": "mul", "value": 2 },
        { "stat": "rules.rallyDamage", "op": "add", "value": 0.3 }
      ]
    },
    {
      "id": "fortress",
      "name": "Fortress",
      "description": "Walls and towers have +40% HP.",
      "modifiers": [
        { "stat": "building.class:wall.hp", "op": "mul", "value": 1.4 },
        { "stat": "building.class:tower.hp", "op": "mul", "value": 1.4 }
      ]
    },
    {
      "id": "hero_king",
      "name": "Hero King",
      "description": "The king has +50% HP and his ability recharges 30% faster.",
      "modifiers": [
        { "stat": "king.hp", "op": "mul", "value": 1.5 },
        { "stat": "weapon.ability.cooldown", "op": "mul", "value": 0.7 }
      ]
    },
    {
      "id": "gamblers_oath",
      "name": "Gambler's Oath",
      "description": "Enemies on nights 5 and 6 have +20% HP. This run's score ×1.25.",
      "modifiers": [
        { "stat": "enemy.*.hp", "op": "mul", "value": 1.2, "nights": [5, 6] },
        { "stat": "rules.scoreMultiplier", "op": "mul", "value": 1.25 }
      ]
    }
  ]
}
